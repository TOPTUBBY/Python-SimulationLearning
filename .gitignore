# Original third-party site bundles are downloaded on the user's device only.
**/site/
**/site.__staging__/
**/site.__backup__/
**/site.__next__/
**/site.__active__.json
**/site.__active__.json.tmp

# Translation cache may contain displayed game data; keep it on the user machine only.
**/translation_cache.json

# Python/OS/logs
__pycache__/
*.py[cod]
.pytest_cache/
*.log
*.part
.DS_Store
Thumbs.db
.vscode/
.idea/

# Portable EXE build outputs
build/
dist/
*.spec
**/site.__next__/
**/site.__active__.json

# EXE binaries live in GitHub Releases rather than Git history
Portable/EXE/*.exe
Portable/EXE/*.zip
Portable/EXE/*.json
Portable/build/
Portable/*.zip
