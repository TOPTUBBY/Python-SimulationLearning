# Original third-party site bundles are downloaded on the user's device only.
**/site/
**/site.__staging__/
**/site.__backup__/

# Python/OS/logs
__pycache__/
*.py[cod]
.pytest_cache/
*.log
*.part
.DS_Store
Thumbs.db
.vscode/
.idea/

# Portable EXE build artifacts (do not commit Windows binaries or staging)
dist/
build/
*.spec
**/site.__next__/
**/site.__active__.json

# Portable binary output is distributed via GitHub Releases instead of Git history
Portable/EXE/*.exe
Portable/EXE/*.zip
Portable/EXE/*.json
Portable/build/
Portable/*.zip

# HowItsWired verified cache slot selection
**/.active-cache.json
**/.active-cache.json.tmp

# HowItsWired verified cache slot selection
**/.active-cache.json
**/.active-cache.json.tmp
